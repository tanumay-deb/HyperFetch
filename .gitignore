# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Build artifacts
build/
dist/
# release zips (uploaded to GitHub Releases, not tracked)
*.zip
*.spec
# ...but keep the hand-maintained PyInstaller specs (canonical build descriptors)
!HyperFetch.spec
!api_server.spec

# Node / extension tests
node_modules/
chrome_ext/test/out.txt
package-lock.json
# ...except the site's, so a release build can use `npm ci` and get the
# exact versions that were tested rather than whatever resolves today.

# Download manager runtime files
*.hfdownload
*.part*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json

# Agent guidance files (kept local, not tracked)
CLAUDE.md
AGENTS.md

# Built users site (produced by build.ps1 / npm run build)
site/

# Server build output
dist-server/
build-server/

# Build sidecars, fetched by build.ps1 rather than committed. ffmpeg alone is
# 145 MB; a stray `git add -A` putting it in history is not recoverable without
# a rewrite, so it is ignored rather than merely untracked.
bin/ffmpeg.exe
bin/aria2c.exe

# Local test material, not part of the project.
Sintel/
filerow_lines.txt

